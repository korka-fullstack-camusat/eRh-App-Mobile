{
  "expo": {
    "name": "eRH-Camusat",
    "slug": "erh-app-mobile",
    "version": "1.0.3",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "sdkVersion": "54.0.0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.camusat.erh.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.camusat.erh.mobile",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-updates"
    ],
    "icon": "./assets/icon.png",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "eRH Camusat",
      "shortName": "eRH-Camusat",
      "themeColor": "#003c71",
      "backgroundColor": "#ffffff"
    },
    "experiments": {
      "baseUrl": "/m"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b412e9fa-c9a5-434b-bc3f-414698abad78",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "b412e9fa-c9a5-434b-bc3f-414698abad78"
      }
    }
  }
}
